{
  "name": "avangcli-vscode",
  "displayName": "AvangCLI Extension",
  "description": "VSCode extension for AvangCLI - Scaffold fullstack projects with Next.js",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "avangcli.initProject",
        "title": "AvangCLI: Initialize New Project",
        "category": "AvangCLI"
      },
      {
        "command": "avangcli.generateModule",
        "title": "AvangCLI: Generate Module",
        "category": "AvangCLI"
      },
      {
        "command": "avangcli.regenerateConfig",
        "title": "AvangCLI: Regenerate Config",
        "category": "AvangCLI"
      },
      {
        "command": "avangcli.generateClients",
        "title": "AvangCLI: Generate TypeScript Clients",
        "category": "AvangCLI"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "avangcli.initProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "avangcli.generateModule",
          "when": "resourceExtname == '.js' || resourceExtname == '.ts' || resourceExtname == '.tsx' || resourceExtname == '.jsx'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AvangCLI",
      "properties": {
        "avangcli.packageManager": {
          "type": "string",
          "default": "bun",
          "enum": [
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "description": "Default package manager to use"
        },
        "avangcli.useTailwind": {
          "type": "boolean",
          "default": true,
          "description": "Use Tailwind CSS by default"
        },
        "avangcli.linterFormatter": {
          "type": "string",
          "default": "biome",
          "enum": [
            "eslint-prettier",
            "biome",
            "none"
          ],
          "description": "Default linter/formatter setup"
        },
        "avangcli.dockerConfig": {
          "type": "string",
          "default": "none",
          "enum": [
            "dev",
            "prod",
            "both",
            "none"
          ],
          "description": "Default Docker configuration"
        },
        "avangcli.uiLibrary": {
          "type": "string",
          "default": "none",
          "enum": [
            "mui",
            "shadcn",
            "heroui",
            "none"
          ],
          "description": "Default UI library"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "eslint": "^8.42.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "typescript": "^5.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ClaudiaQueipo/avangcli"
  },
  "publisher": "avangenio",
  "icon": "images/avangcli2.png"
}