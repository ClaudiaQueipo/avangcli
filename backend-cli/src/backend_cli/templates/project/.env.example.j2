# Application
APP_NAME={{ project_name }}
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
{% if database == "postgres" %}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ package_name }}
{% elif database == "mysql" %}
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/{{ package_name }}
{% elif database == "sqlserver" %}
DATABASE_URL=mssql+aioodbc://sa:YourStrong@Passw0rd@localhost:1433/{{ package_name }}?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
{% endif %}

# Database Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000"]
